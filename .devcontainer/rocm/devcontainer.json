{
    "name": "MMDetection3D AMD ROCm - RX 6700 XT",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".",
        "options": ["--network=host"]
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/mmdetection3d,type=bind",
    "workspaceFolder": "/workspace/mmdetection3d",
    "runArgs": [
        "--device=/dev/kfd",
        "--device=/dev/dri",
        "--group-add=44",
        "--group-add=990",
        "--shm-size=16g"
    ],
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,
    "containerEnv": {
        "MMDET3D_DEVICE": "rocm",
        "HSA_OVERRIDE_GFX_VERSION": "10.3.0",
        "PYTHONPATH": "/workspace/mmdetection3d",
        "PYTHONUNBUFFERED": "1",
        "MPLCONFIGDIR": "/tmp/matplotlib-cache"
    },
    "postCreateCommand": "bash .devcontainer/rocm/post-create.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/mmdet3d-venv/bin/python",
                "python.terminal.activateEnvironment": false
            }
        }
    }
}
